# =====================================================================
# OpenSDR - Environment Configuration Template
# =====================================================================
# Copy this file to .env and customize as needed:
#   cp .env.example .env
#
# OpenSDR works 100% free out-of-the-box using direct DNS MX lookups,
# RFC permutations, web crawling, and deterministic heuristic NLP fallback.
# All API keys below are completely OPTIONAL.
# =====================================================================

# ---------------------------------------------------------------------
# AI / LLM Engine Settings (Optional - Defaults to Free Heuristic NLP)
# ---------------------------------------------------------------------
# Google Gemini API key (recommended for fast inference)
GEMINI_API_KEY=

# OpenAI API key (defaults to GPT-6 Luna)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Local Ollama endpoint (e.g. http://localhost:11434)
OLLAMA_BASE_URL=

# ---------------------------------------------------------------------
# Enrichment API Providers (Optional - Defaults to Free DNS Waterfall)
# ---------------------------------------------------------------------
# Hunter.io API key for secondary verification
HUNTER_API_KEY=

# Apollo.io API key for secondary phone/email discovery
APOLLO_API_KEY=

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# SQLite (default) or PostgreSQL (e.g. postgresql://user:pass@localhost:5432/opensdr)
DATABASE_URL=sqlite:///./data/opensdr.db

# ---------------------------------------------------------------------
# Outbound SMTP Mailbox (Optional - Defaults to Mock Dispatcher)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outreach@example.com

# ---------------------------------------------------------------------
# Inbound IMAP Mailbox Listener (Optional - Defaults to In-Memory/Simulated)
# ---------------------------------------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# ---------------------------------------------------------------------
# Calendar Scheduling URL
# ---------------------------------------------------------------------
DEFAULT_BOOKING_URL=https://cal.com/team/15min
